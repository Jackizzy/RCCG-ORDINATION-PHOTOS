# Copy this file to ".env" and fill in your values.

# Port the server runs on
PORT=3000

# Public URL of your site (used for the Paystack redirect after payment).
# Example when deployed: https://photos.yourchurch.org
BASE_URL=http://localhost:3000

# CHANGE THIS. Password for the /admin panel.
ADMIN_PASSWORD=change-me-now

# Paystack keys — from https://dashboard.paystack.com > Settings > API Keys & Webhooks.
# Leave the secret key empty to run in DEMO MODE (payments are simulated, for testing).
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Set to 0 ONLY if the app faces the internet directly with no reverse proxy
# (Render/Railway/Nginx/Caddy all count as proxies — leave this unset for them).
TRUST_PROXY=

# Optional: secret used to sign download links & admin sessions.
# If left empty, one is generated automatically and stored in the database.
APP_SECRET=
